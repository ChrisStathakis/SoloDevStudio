# VITE_API_URL: Django backend base.
# "/api" = same-origin via Express (server.ts) or Vite proxy — no CORS needed (recommended).
# "http://localhost:8001/api" = direct cross-origin — requires Django CORS (kept as fallback).
VITE_API_URL="/api"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
