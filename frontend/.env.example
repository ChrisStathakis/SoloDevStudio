# VITE_API_URL: Django backend base.
# "/api" = same-origin via Express (server.ts) or Vite proxy — no CORS needed (recommended).
# "http://localhost:8001/api" = direct cross-origin — requires Django CORS (kept as fallback).
VITE_API_URL="/api"

# VITE_CLOUD_API_URL: remote PythonAnywhere Django base for cloud sync.
# Example: "https://username.pythonanywhere.com/api". Empty = cloud sync disabled
# until the user sets the server URL in Settings > Data & Backup.
VITE_CLOUD_API_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
