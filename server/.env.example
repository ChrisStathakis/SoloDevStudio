SECRET_KEY=django-insecure-dev-key-change-in-prod-solodev-2026
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5174,http://127.0.0.1:5174
# When True (dev default), any localhost origin is accepted so new Vite/Express ports don't trigger CORS preflight failures.
CORS_ALLOW_ALL_ORIGINS=True
APP_URL=http://localhost:8001
POTENTIAL_PROJECTS_ROOT=D:\projects\potential_projects

# --- Production (e.g. PythonAnywhere) ---
# Copy these over the dev values above; renderer origins must be listed
# explicitly because CORS_ALLOW_ALL_ORIGINS stays False in production.
# SECRET_KEY=<long-random-secret>
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.pythonanywhere.com
# CORS_ALLOWED_ORIGINS=app://solodev,http://localhost:3000
# APP_URL=https://yourdomain.pythonanywhere.com
